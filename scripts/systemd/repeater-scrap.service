# Runs the repeater-db scrapers once; started hourly by repeater-scrap.timer.
# Install: see /opt/repeater-scrap/README.md, section "Service (systemd)".
#
# The scripts are in /opt/repeater-scrap (a copy of repeater-db/scripts). The
# database config /etc/repeater-scrap/db_config.ini (root only) is passed in
# as a credential. The service runs as a temporary user "repeater_scrap",
# which connects to PostgreSQL over the local socket as the role of the same
# name (peer authentication, no password); create_scrap_tables.sql creates
# that role and allows it to INSERT into the scrap_* tables only.
#
# A run with a failed scraper exits with status 1: the unit is then "failed"
# (systemctl status repeater-scrap, journalctl -u repeater-scrap).

[Unit]
Description=Scrape repeater lists into the vhf database
Documentation=file:/opt/repeater-scrap/README.md
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/repeater-scrap/scrap_all.py
WorkingDirectory=/opt/repeater-scrap
# A hanging run must not block the next one (every download times out after 15 s).
TimeoutStartSec=10min

DynamicUser=yes
User=repeater_scrap
LoadCredential=db_config.ini:/etc/repeater-scrap/db_config.ini
# /opt/repeater-scrap is read-only for the service: no __pycache__ there.
Environment=PYTHONDONTWRITEBYTECODE=1

# Hardening: only network + local sockets, nothing writable.
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
UMask=0077
